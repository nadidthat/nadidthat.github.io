---
import { getPersona, personas, site, type PersonaSlug } from '@/data/site';

interface Props {
  slug: PersonaSlug;
}

const { slug } = Astro.props;
const persona = getPersona(slug);
const others = personas.filter((p) => p.slug !== slug);
---

<article>
  <!-- hero -->
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 lg:px-10 lg:pt-16">
    <div class="flex items-start justify-between">
      <p class="eyebrow text-sm text-ink">{persona.kicker}</p>
      <div class="flex items-center gap-3" aria-hidden="true">
        <span class="size-3 rounded-full border border-ink"></span>
        <span class="size-3 rounded-full border border-ink"></span>
        <span class="size-3 rounded-full border border-ink"></span>
      </div>
    </div>

    <h1 class="display mt-4 text-7xl leading-[0.9] sm:text-8xl lg:text-[10rem]">{persona.label}</h1>

    <p class="mt-8 max-w-2xl text-lg text-ink-soft sm:text-xl">{persona.intro}</p>
  </section>

  <!-- about -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:items-start">
      <h2 class="display text-4xl sm:text-5xl">About</h2>
      <div class="max-w-2xl space-y-5 text-base text-ink-soft">
        {persona.body.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- selected works -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-10">
    <h2 class="display text-4xl sm:text-5xl">Selected Works</h2>
    <ul class="mt-10 grid gap-px border border-ink bg-ink sm:grid-cols-3">
      {persona.works.map((w) => (
        <li class="flex flex-col bg-canvas p-6">
          <p class="eyebrow text-xs text-muted-foreground">{w.meta}</p>
          <h3 class="display mt-3 text-2xl">{w.title}</h3>
          <p class="mt-3 text-sm text-ink-soft">{w.description}</p>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-xs text-muted-foreground">
      Placeholder content — replace with real work in <code>src/data/site.ts</code>.
    </p>
  </section>

  <!-- explore other personas -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:px-10">
    <p class="eyebrow text-xs text-muted-foreground">Explore</p>
    <ul class="mt-6 grid gap-px border border-ink bg-ink sm:grid-cols-2">
      {others.map((o) => (
        <li>
          <a
            href={`/${o.slug}`}
            class="group flex items-center justify-between bg-canvas p-6 transition-colors hover:bg-ink hover:text-canvas"
          >
            <span class="display text-3xl">{o.label}</span>
            <span class="text-xl transition-transform group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-4 pb-28 sm:px-6 lg:px-10">
    <a
      href="/#work-with-me"
      class="group relative flex min-h-64 items-end overflow-hidden bg-ink p-8 text-canvas lg:min-h-80 lg:p-12"
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(120deg,#0a0a0a_0%,#454550_60%,#0f0f13_100%)] grayscale transition-transform duration-500 group-hover:scale-[1.03]"
        aria-hidden="true"
      ></div>
      <h2 class="display relative text-5xl sm:text-6xl lg:text-7xl">
        Work
        <br />
        With Me
      </h2>
    </a>
    <p class="mt-4 text-sm text-ink-soft">
      Reach out at{' '}
      <a href={`mailto:${site.email}`} class="text-ink underline underline-offset-4">
        {site.email}
      </a>
      .
    </p>
  </section>
</article>
