---
import { cn } from '@/lib/utils';
import type { HTMLAttributes } from 'react';

interface Props {
  solid?: boolean;
}

const { solid = false } = Astro.props as Props & HTMLAttributes<HTMLSpanElement>;
---

<span class:list={cn(`border-ink h-5 w-12 border-4 sm:h-10 sm:w-24`, solid && 'bg-ink')}></span>
