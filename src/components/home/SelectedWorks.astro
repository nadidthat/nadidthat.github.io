---
import { personas } from '@/data/site';
import selectedWorksImage from '@/assets/selected-works.png';
---

<section id="selected-works" class="mx-auto max-w-6xl px-4 sm:px-12 lg:px-10">
  <div class="group relative flex min-h-72 items-center overflow-hidden bg-ink p-8 text-canvas lg:min-h-96 lg:p-12">
    <div
      class="absolute inset-0 bg-cover bg-no-repeat bg-bottom transition-transform duration-300 group-hover:scale-[1.05]"
      style={`background-image: url(${selectedWorksImage.src})`}
    ></div>
    <h2 class="display relative text-5xl sm:text-7xl lg:text-8xl">
      Selected
      <br />
      Works
    </h2>
  </div>

  <div class="mt-16 grid gap-12 lg:grid-cols-[1.5fr_1fr]">
    <ul class="flex flex-col gap-6">
      {personas.map((persona) => (
        <li class="group flex items-center justify-between border border-ink px-6 py-7 transition-colors hover:bg-ink hover:text-canvas">
          <span class="display text-2xl sm:text-3xl">{persona.workCategory}</span>
        </li>
      ))}
    </ul>

    <div>
      <h3 class="display text-2xl">Why me?</h3>
      <p class="mt-4 text-ink-soft">
        I&rsquo;m someone who thrives off my versatility and adaptability, which allows me to adjust
        myself to your needs and provide a solution that&rsquo;s most suitable for you.
      </p>
    </div>
  </div>
</section>
