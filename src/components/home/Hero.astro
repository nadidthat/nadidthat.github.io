---
import { site } from '@/data/site';
import Circles from '@/components/Circles.astro';
import portraitImage from '@/assets/portrait.png';
---

<section id="hero" class="relative mx-auto max-w-6xl px-4 pt-5 sm:px-12 lg:pt-16">
  <img
    src=`${portraitImage.src}`
    alt="portrait"
    class="absolute left-4 sm:left-12 bottom-0 -z-10 max-w-full h-50 sm:h-100"
  />

  <div class="flex items-start justify-between">
    <p class="eyebrow text-ink text-3xl md:text-6xl font-bold">Hi, I am</p>
    <div class="flex items-center gap-3" aria-hidden="true">
      <Circles />
    </div>
  </div>

  <h1 class="display ml-[-0.06em] mt-4 text-[18vw] leading-[0.85] sm:text-[15vw] lg:text-[11rem]">
    Nadia
    <br />
    Nathania
  </h1>

  <ul class="pl-[50%] leading-5 sm:leading-15 mt-10 display space-y-1 text-xl text-muted-ink sm:text-5xl lg:text-6xl md:mx-auto">
    {site.roles.map((role) => (
      <li>{role}</li>
    ))}
  </ul>
</section>
