---
import Circles from '@/components/Circles.astro';
import Rectangle from '@/components/Rectangle.astro';
---

<section id="about-me" class="mx-auto max-w-6xl px-4 py-8 sm:px-12 lg:px-10">
  <div class="mt-12 flex justify-end lg:mt-16" aria-hidden="true">
    <Rectangle solid />
  </div>

  <div class="mt-12 grid sm:gap-10 grid-cols-3 items-start">
    <div class="flex flex-col gap-3" aria-hidden="true">
      <Rectangle solid />
      <Rectangle />
    </div>

    <h2 class="col-span-2 display text-right mt-[-0.06em] text-5xl sm:text-7xl lg:text-8xl">
      About
      <br />
      Me
    </h2>
  </div>

  <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
    <p class="max-w-md text-sm sm:text-base text-ink-soft">
      A medical doctor, writer, designer, and illustrator passionate about mental health and
      providing holistic, purposeful, and personalized solutions.
    </p>
    <div class="flex items-center gap-3 justify-end" aria-hidden="true">
      <Circles />
    </div>
  </div>
</section>
