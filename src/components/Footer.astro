---
import { navLinks, site } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink/10 bg-canvas mx-auto max-w-6xl px-4 sm:px-12 lg:px-10">
  <div class="mx-auto max-w-6xl py-16">
    <div class="sm:col-span-2 lg:col-span-2">
      <a href="/" class="text-lg font-bold tracking-tight text-ink hover:opacity-70">
        {site.brand}
      </a>
    </div>

    <ul class="mt-4 flex flex-col gap-2">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="text-ink-soft transition-colors hover:text-ink">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="mx-auto flex max-w-6xl flex-col gap-2 pb-10 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
    <p>
      &copy;{year} {site.name}. All rights reserved.
    </p>
    <p>Doctor · Designer · Writer</p>
  </div>
</footer>
